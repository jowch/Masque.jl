# Julia
/Manifest.toml
.cursor/sysimage/Manifest.toml
*.jl.cov
*.jl.*.cov
*.jl.mem
/docs/build/
# Obsolete whole-notebook HTML export. Nothing writes this directory.
/docs/src/notebooks/
# Generated cell-series players — harvested by docs/export_embeds.jl at build time.
/docs/src/embeds/*.html
# Their text twins' idle readouts (docs/player_fallback.jl); the idle figure PNG
# is already covered by `*.png` below.
/docs/src/embeds/*.fallback.toml

# Node / TypeScript (`frontend/`). The built bundles assets/overlay.js and
# assets/masque-webgl.js ARE committed.
frontend/node_modules/
frontend/dist/
frontend/coverage/
test/e2e/node_modules/
test/e2e/package-lock.json
*.tsbuildinfo
npm-debug.log*

# Local-only — not part of the package
/.worktrees/
/.superpowers/
/spike/
/pluto-makie-interactive-plots.md
.playwright-mcp/
*.png
# Gallery card screenshots are tracked; other PNGs stay local.
!docs/src/assets/gallery/*.png
